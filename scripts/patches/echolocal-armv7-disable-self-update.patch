+// Install refuses ARMv7 self-updates. A valid upstream ARM64 image could
+// otherwise replace this binary because the manifest has no architecture field.
+func (u *Firmware) Install(context.Context) {
+	const reason = "self-update disabled on ARMv7; flash a TWRP installer"
+	slog.Warn(reason)
+	u.publish(update.Manifest{Version: layout.Version})
+	u.Settled(EventFailed, reason)
