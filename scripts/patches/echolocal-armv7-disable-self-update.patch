+// Check keeps ARMv7 up to date without fetching an upstream manifest. Those
+// manifests do not identify a binary architecture, so ARMv7 updates use TWRP.
+func (u *Firmware) Check(context.Context) {
+	u.publish(update.Manifest{Version: layout.Version})
