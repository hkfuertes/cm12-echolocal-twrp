new file mode 100644
index 0000000..0eb1854
--- /dev/null
+++ b/internal/lib/alsa/abi_arm.go
@@ -0,0 +1,15 @@
+//go:build arm
+
+package alsa
+
+// These compile-time checks keep the ARM EABI layouts in sync with Linux.
+var (
+	_ [longSize - 4]byte
+	_ [4 - longSize]byte
+	_ [hwParamsSize - 604]byte
+	_ [604 - hwParamsSize]byte
+	_ [xferiSize - 12]byte
+	_ [12 - xferiSize]byte
+	_ [elemValueSize - 712]byte
+	_ [712 - elemValueSize]byte
+)
