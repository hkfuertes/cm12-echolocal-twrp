diff --git a/internal/lib/input/abi_arm.go b/internal/lib/input/abi_arm.go
new file mode 100644
index 0000000..555b874
--- /dev/null
+++ b/internal/lib/input/abi_arm.go
@@ -0,0 +1,11 @@
+//go:build arm
+
+package input
+
+// These compile-time checks keep the ARM EABI evdev record in sync with Linux struct input_event.
+var (
+	_ [longSize - 4]byte
+	_ [4 - longSize]byte
+	_ [eventSize - 16]byte
+	_ [16 - eventSize]byte
+)
diff --git a/internal/lib/input/input.go b/internal/lib/input/input.go
index 23c8dff..66008b1 100644
--- a/internal/lib/input/input.go
+++ b/internal/lib/input/input.go
@@ -9,0 +10 @@ import (
+	"unsafe"
@@ -26 +27,2 @@ const (
-	longSize  = 8
+	// longSize matches the target kernel ABI: input_event timestamps are two longs.
+	longSize  = int(unsafe.Sizeof(uintptr(0)))
@@ -115,2 +117,2 @@ func (d *Device) Read() (Event, error) {
-		Sec:   binary.LittleEndian.Uint64(buf[0:]),
-		Usec:  binary.LittleEndian.Uint64(buf[longSize:]),
+		Sec:   readLong(buf[0:]),
+		Usec:  readLong(buf[longSize:]),
@@ -122,0 +125,7 @@ func (d *Device) Read() (Event, error) {
+func readLong(buf []byte) uint64 {
+	if longSize == 4 {
+		return uint64(binary.LittleEndian.Uint32(buf))
+	}
+	return binary.LittleEndian.Uint64(buf)
+}
+
