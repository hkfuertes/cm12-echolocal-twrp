#!/sbin/sh
set -eu

OUTFD=${2:-}
ZIP=${3:-}
SYSTEM=${ECHOLOCAL_SYSTEM:-/system}
TMPDIR=${ECHOLOCAL_TMPDIR:-/dev/tmp}
ADDON_NAME=@ADDON_NAME@
VERSION=@VERSION@
BASE_LEDCONTROLLER_SHA256=@BASE_LEDCONTROLLER_SHA256@
MANIFEST_SHA256=@MANIFEST_SHA256@
PAYLOAD_BYTES=@PAYLOAD_BYTES@

GETPROP=${GETPROP:-getprop}
SHA256SUM=${SHA256SUM:-sha256sum}
UNZIP=${UNZIP:-unzip}
CHCON=${CHCON:-chcon}
DF=${DF:-df}

SERVICE="$SYSTEM/bin/ledcontroller"
BACKUP="$SERVICE.orig"
ECHOD="$SYSTEM/app/echod/echod"
BASE_BUSYBOX="$SYSTEM/xbin/busybox"
START_ANIMATION="$SYSTEM/bin/start_animation.sh"
STOP_ANIMATION="$SYSTEM/bin/stop_animation.sh"
START_BACKUP="$START_ANIMATION.orig"
STOP_BACKUP="$STOP_ANIMATION.orig"
MARKER="$SYSTEM/etc/echolocal/.biscuit-addon"
STAGE=
FIRST_INSTALL=0
SERVICE_BACKED_UP=0
START_BACKED_UP=0
STOP_BACKED_UP=0
HOOK_MODE=
CREATED_DIRS=

ui_print() {
    if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
        printf 'ui_print %s\nui_print\n' "$*" > "/proc/self/fd/$OUTFD"
    else
        printf '%s\n' "$*"
    fi
}

die() {
    ui_print "E: $*"
    exit 1
}

need_tool() {
    command -v "$1" >/dev/null 2>&1 || die "recovery lacks required tool: $1"
}

hash_file() {
    "$SHA256SUM" "$1" | awk '{print $1}'
}

require_regular() {
    [ -f "$1" ] && [ ! -L "$1" ] || die "expected regular file: $1"
}

require_link_target() {
    link=$1
    expected=$2
    [ -L "$link" ] || die "expected symlink: $link"
    target=$(readlink "$link" 2>/dev/null || true)
    [ "$target" = "$expected" ] || die "unexpected symlink target for $link: ${target:-unknown}"
}

path_absent() {
    [ ! -e "$1" ] && [ ! -L "$1" ]
}

read_prop() {
    prop_name=$1
    prop_value=$("$GETPROP" "$prop_name" 2>/dev/null || true)
    if [ -z "$prop_value" ]; then
        for prop_file in /default.prop "$SYSTEM/build.prop"; do
            [ -f "$prop_file" ] || continue
            prop_value=$(sed -n "s/^$prop_name=//p" "$prop_file" | head -n 1)
            [ -z "$prop_value" ] || break
        done
    fi
    printf '%s' "$prop_value"
}

ensure_system() {
    [ -d "$SYSTEM" ] || die "missing system mount: $SYSTEM"
    [ "$SYSTEM" != /system ] && return 0
    if mount | grep -Eq '[[:space:]]/system[[:space:]]'; then
        return 0
    fi
    mount /system >/dev/null 2>&1 || die 'could not mount /system'
}

label_system_file() {
    # ponytail: TWRP 3.2.3 rejects chcon here; make this fatal if a supported recovery needs relabeling.
    "$CHCON" --reference="$BACKUP" "$1" >/dev/null 2>&1 || true
}

free_kb() {
    if [ "${ECHOLOCAL_FREE_KB+x}" = x ]; then
        printf '%s\n' "$ECHOLOCAL_FREE_KB"
        return 0
    fi
    "$DF" -k "$SYSTEM" |
        awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+%$/ && $(i - 1) ~ /^[0-9]+$/) { print $(i - 1); exit } }'
}

ensure_dir() {
    directory=$1
    [ ! -L "$directory" ] || die "refusing symlink directory: $directory"
    if [ ! -d "$directory" ]; then
        mkdir -p "$directory" || die "could not create $directory"
        CREATED_DIRS="$directory $CREATED_DIRS"
    fi
    chmod 0755 "$directory" || die "could not set mode on $directory"
    label_system_file "$directory"
}

install_file() {
    relative=$1
    mode=$2
    source="$STAGE/payload/system/$relative"
    destination="$SYSTEM/$relative"
    require_regular "$source"
    [ ! -L "$destination" ] || die "refusing to follow symlink: $destination"
    source_hash=$(hash_file "$source")
    cp "$source" "$destination" || die "could not install $destination"
    chmod "$mode" "$destination" || die "could not set mode on $destination"
    label_system_file "$destination"
    [ "$(hash_file "$destination")" = "$source_hash" ] || die "installed hash mismatch: $destination"
}

install_marker() {
    install_file etc/echolocal/.biscuit-addon 644
    printf 'animation_hooks=%s\n' "$HOOK_MODE" >> "$MARKER" || die 'could not write add-on marker'
}

install_service_link() {
    temporary="$SERVICE.echolocal-new"
    [ ! -e "$temporary" ] && [ ! -L "$temporary" ] || die "temporary service path already exists"
    ln -s "$ECHOD" "$temporary" || die 'could not create ledcontroller symlink'
    mv -f "$temporary" "$SERVICE" || {
        rm -f "$temporary"
        die 'could not activate ledcontroller symlink'
    }
    require_link_target "$SERVICE" "$ECHOD"
}

remove_new_payload() {
    rm -f "$SERVICE" \
        "$SYSTEM/bin/echolocal" \
        "$ECHOD" \
        "$MARKER" 2>/dev/null || true
    if [ "$HOOK_MODE" = managed ]; then
        [ "$START_BACKED_UP" -eq 0 ] || rm -f "$START_ANIMATION" 2>/dev/null || true
        [ "$STOP_BACKED_UP" -eq 0 ] || rm -f "$STOP_ANIMATION" 2>/dev/null || true
    fi
    for model in okay_nabu hey_jarvis hey_mycroft; do
        rm -f "$SYSTEM/etc/echolocal/models/$model.json" \
            "$SYSTEM/etc/echolocal/models/$model.tflite" 2>/dev/null || true
    done
    for directory in $CREATED_DIRS; do
        rmdir "$directory" 2>/dev/null || true
    done
}

finish() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ "$status" -ne 0 ] && [ "$FIRST_INSTALL" -eq 1 ]; then
        remove_new_payload
        [ "$STOP_BACKED_UP" -eq 0 ] || mv "$STOP_BACKUP" "$STOP_ANIMATION" 2>/dev/null || true
        [ "$START_BACKED_UP" -eq 0 ] || mv "$START_BACKUP" "$START_ANIMATION" 2>/dev/null || true
        [ "$SERVICE_BACKED_UP" -eq 0 ] || mv "$BACKUP" "$SERVICE" 2>/dev/null || true
    fi
    [ -z "$STAGE" ] || rm -rf "$STAGE"
    exit "$status"
}
trap finish EXIT HUP INT TERM

for tool in "$GETPROP" "$SHA256SUM" "$UNZIP" "$CHCON" "$DF" awk cp chmod find grep head ln mkdir mount mv readlink rm sed sha256sum; do
    need_tool "$tool"
done

[ -n "$ZIP" ] && [ -f "$ZIP" ] || die 'missing installation ZIP'
product=$(read_prop ro.product.device)
[ -n "$product" ] || product=$(read_prop ro.build.product)
[ "$product" = biscuit ] || die "this ZIP is only for Biscuit (got ${product:-unknown})"
ensure_system
require_regular "$BASE_BUSYBOX"
[ -x "$BASE_BUSYBOX" ] || die "base BusyBox is not executable: $BASE_BUSYBOX"

if [ -f "$MARKER" ]; then
    require_regular "$MARKER"
    grep -qx "name=$ADDON_NAME" "$MARKER" || die 'unknown EchoLocal add-on marker'
    grep -qx "base_ledcontroller_sha256=$BASE_LEDCONTROLLER_SHA256" "$MARKER" ||
        die 'add-on marker does not match the supported generic base'
    require_regular "$BACKUP"
    [ "$(hash_file "$BACKUP")" = "$BASE_LEDCONTROLLER_SHA256" ] ||
        die 'preserved generic ledcontroller does not match the supported base'
    require_link_target "$SERVICE" "$ECHOD"
    if grep -qx 'animation_hooks=managed' "$MARKER"; then
        HOOK_MODE=managed
        require_regular "$START_ANIMATION"
        require_regular "$STOP_ANIMATION"
        require_regular "$START_BACKUP"
        require_regular "$STOP_BACKUP"
    elif grep -qx 'animation_hooks=absent' "$MARKER"; then
        HOOK_MODE=absent
        path_absent "$START_BACKUP" || die 'unexpected start_animation.sh backup'
        path_absent "$STOP_BACKUP" || die 'unexpected stop_animation.sh backup'
        for path in "$START_ANIMATION" "$STOP_ANIMATION"; do
            [ ! -L "$path" ] || die "refusing symlink hook: $path"
            [ ! -e "$path" ] || require_regular "$path"
        done
    else
        die 'add-on marker lacks animation-hook ownership'
    fi
    [ ! -e "$ECHOD.prev" ] || die 'echod.prev is pending rollback; boot once before upgrading'
else
    require_regular "$SERVICE"
    [ "$(hash_file "$SERVICE")" = "$BASE_LEDCONTROLLER_SHA256" ] ||
        die 'unsupported generic base: ledcontroller hash does not match'
    if [ -f "$START_ANIMATION" ] && [ ! -L "$START_ANIMATION" ] && \
        [ -f "$STOP_ANIMATION" ] && [ ! -L "$STOP_ANIMATION" ]; then
        HOOK_MODE=managed
    elif path_absent "$START_ANIMATION" && path_absent "$STOP_ANIMATION"; then
        HOOK_MODE=absent
    else
        die 'animation hooks are partially present or symlinked'
    fi
    for path in "$BACKUP" "$START_BACKUP" "$STOP_BACKUP" \
        "$SYSTEM/bin/echolocal" "$SYSTEM/app/echod" \
        "$SYSTEM/etc/echolocal"; do
        path_absent "$path" || die "refusing to overwrite existing path: $path"
    done
fi

available=$(free_kb)
case "$available" in
    ''|*[!0-9]*) die "could not determine free space on $SYSTEM" ;;
esac
needed=$((PAYLOAD_BYTES / 1024 + 1024))
[ "$available" -ge "$needed" ] ||
    die "insufficient free space on $SYSTEM: need ${needed}KiB, have ${available}KiB"

STAGE="$TMPDIR/echolocal-install.$$"
rm -rf "$STAGE"
mkdir -p "$STAGE" || die 'could not create recovery staging directory'
"$UNZIP" -o "$ZIP" 'payload/*' payload-manifest.sha256 -d "$STAGE" >/dev/null ||
    die 'could not extract payload'
require_regular "$STAGE/payload-manifest.sha256"
[ "$(hash_file "$STAGE/payload-manifest.sha256")" = "$MANIFEST_SHA256" ] ||
    die 'payload manifest hash mismatch'
( cd "$STAGE" && "$SHA256SUM" -c payload-manifest.sha256 ) >/dev/null 2>&1 ||
    die 'payload file hash mismatch'
[ -z "$(find "$STAGE/payload" -type l -print)" ] || die 'payload contains an unexpected symlink'

for relative in \
    system/bin/echolocal \
    system/bin/start_animation.sh \
    system/bin/stop_animation.sh \
    system/app/echod/echod \
    system/etc/echolocal/.biscuit-addon \
    system/etc/echolocal/models/okay_nabu.json \
    system/etc/echolocal/models/okay_nabu.tflite \
    system/etc/echolocal/models/hey_jarvis.json \
    system/etc/echolocal/models/hey_jarvis.tflite \
    system/etc/echolocal/models/hey_mycroft.json \
    system/etc/echolocal/models/hey_mycroft.tflite; do
    require_regular "$STAGE/payload/$relative"
done
grep -qx "name=$ADDON_NAME" "$STAGE/payload/system/etc/echolocal/.biscuit-addon" ||
    die 'payload marker has the wrong name'
grep -qx "base_ledcontroller_sha256=$BASE_LEDCONTROLLER_SHA256" \
    "$STAGE/payload/system/etc/echolocal/.biscuit-addon" || die 'payload marker has the wrong base'

if [ ! -f "$MARKER" ]; then
    FIRST_INSTALL=1
    mv "$SERVICE" "$BACKUP" || die 'could not preserve the generic ledcontroller'
    SERVICE_BACKED_UP=1
    if [ "$HOOK_MODE" = managed ]; then
        mv "$START_ANIMATION" "$START_BACKUP" || die 'could not preserve start_animation.sh'
        START_BACKED_UP=1
        mv "$STOP_ANIMATION" "$STOP_BACKUP" || die 'could not preserve stop_animation.sh'
        STOP_BACKED_UP=1
    fi
fi

ensure_dir "$SYSTEM/app/echod"
ensure_dir "$SYSTEM/etc/echolocal"
ensure_dir "$SYSTEM/etc/echolocal/models"

install_file bin/echolocal 755
install_file app/echod/echod 755
if [ "$HOOK_MODE" = managed ]; then
    install_file bin/start_animation.sh 755
    install_file bin/stop_animation.sh 755
fi
for model in okay_nabu hey_jarvis hey_mycroft; do
    install_file "etc/echolocal/models/$model.json" 644
    install_file "etc/echolocal/models/$model.tflite" 644
done
install_service_link
install_marker

ui_print "$ADDON_NAME $VERSION installed; run echolocal repair after a /data wipe"
