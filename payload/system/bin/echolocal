#!/system/bin/sh
# Root-ADB controls and persistent ESPHome key management for this add-on.
set -eu

SYSTEM=${ECHOLOCAL_SYSTEM:-/system}
STATE=${ECHOLOCAL_STATE:-/data/misc/echolocal}
BB="$SYSTEM/xbin/busybox"
KEY="$STATE/psk"
MODELS="$STATE/models"
SEED="$SYSTEM/etc/echolocal/models"

fail() {
    printf 'echolocal: %s\n' "$*" >&2
    exit 1
}

[ -x "$BB" ] || fail "missing base BusyBox"

require_root() {
    case "$("$BB" id)" in
        uid=0\(*) ;;
        *) fail 'requires root ADB' ;;
    esac
}

ensure_state() {
    "$BB" mkdir -p "$STATE"
    "$BB" chown root:system "$STATE"
    "$BB" chmod 0770 "$STATE"
}

write_key() {
    tmp="$STATE/.psk.$$"
    umask 077
    "$BB" dd if=/dev/urandom bs=32 count=1 2>/dev/null | "$BB" base64 > "$tmp"
    [ "$("$BB" wc -c < "$tmp")" = 45 ] || {
        "$BB" rm -f "$tmp"
        fail 'could not generate a 32-byte key'
    }
    "$BB" chown root:system "$tmp"
    "$BB" chmod 0600 "$tmp"
    "$BB" mv -f "$tmp" "$KEY"
}

key_ensure() {
    ensure_state
    [ -s "$KEY" ] || write_key
    "$BB" chown root:system "$KEY"
    "$BB" chmod 0600 "$KEY"
}

key_show() {
    [ -s "$KEY" ] || fail "no key at $KEY"
    "$BB" cat "$KEY"
}

key_rotate() {
    ensure_state
    write_key
    "$SYSTEM/bin/setprop" ctl.restart ledcontroller
    printf '%s\n' 'Update Home Assistant with this new key:' >&2
    key_show
}

seed_model() {
    model=$1
    for extension in json tflite; do
        source="$SEED/$model.$extension"
        destination="$MODELS/$model.$extension"
        [ -f "$source" ] || fail "missing seeded model: $source"
        if [ ! -f "$destination" ]; then
            "$BB" cp "$source" "$destination"
            "$BB" chown root:system "$destination"
            "$BB" chmod 0644 "$destination"
        fi
    done
}

repair() {
    had_key=0
    [ -s "$KEY" ] && had_key=1
    key_ensure
    "$BB" mkdir -p "$MODELS"
    "$BB" chown root:system "$MODELS"
    "$BB" chmod 0770 "$MODELS"
    for model in okay_nabu hey_jarvis hey_mycroft; do
        seed_model "$model"
    done
    "$SYSTEM/bin/setprop" ctl.restart ledcontroller
    [ "$had_key" -eq 1 ] ||
        printf '%s\n' 'A new ESPHome key was generated; run `echolocal key show` before pairing again.' >&2
}

usage() {
    cat >&2 <<'EOF'
Usage:
  echolocal repair
  echolocal key show|rotate
EOF
    exit 2
}

require_root
case "${1:-}" in
    repair)
        [ "$#" -eq 1 ] || usage
        repair
        ;;
    key)
        case "${2:-}" in
            ensure) key_ensure ;;
            show) key_show ;;
            rotate) key_rotate ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
